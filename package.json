{
  "name": "school-marks-backend",
  "version": "1.0.0",
  "description": "Express and MongoDB backend for teacher subject/class/division marks management.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "configure:atlas": "powershell -ExecutionPolicy Bypass -File scripts/configure-atlas.ps1",
    "dev": "nodemon src/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run client:dev\"",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "latest"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "latest"
  }
}
